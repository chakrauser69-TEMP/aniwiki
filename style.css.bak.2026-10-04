*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg: #0a0a0f;
    --bg-secondary: #12121a;
    --glass: rgba(255, 255, 255, 0.04);
    --glass-hover: rgba(255, 255, 255, 0.08);
    --glass-border: rgba(255, 255, 255, 0.08);
    --text: #e8e8f0;
    --text-secondary: #8888a0;
    --text-muted: #55556a;
    --accent: #7c3aed;
    --accent-light: #a78bfa;
    --accent-glow: rgba(124, 58, 237, 0.15);
    --gold: #f59e0b;
    --green: #10b981;
    --red: #ef4444;
    --blue: #3b82f6;
    --pink: #ec4899;
    --radius: 16px;
    --radius-sm: 10px;
    --shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme="light"] {
    --bg: #f0f0f5;
    --bg-secondary: #ffffff;
    --glass: rgba(255, 255, 255, 0.65);
    --glass-hover: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(0, 0, 0, 0.06);
    --text: #1a1a2e;
    --text-secondary: #5a5a72;
    --text-muted: #9898ac;
    --accent: #7c3aed;
    --accent-light: #6d28d9;
    --accent-glow: rgba(124, 58, 237, 0.1);
    --shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
}

html { scroll-behavior: smooth; }

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
    overflow-x: hidden;
    transition: background var(--transition), color var(--transition);
}

.bg-orbs {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
}

.orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.4;
}

.orb-1 {
    width: 600px; height: 600px;
    background: var(--accent);
    top: -200px; right: -100px;
    opacity: 0.12;
}

.orb-2 {
    width: 500px; height: 500px;
    background: var(--pink);
    bottom: -150px; left: -100px;
    opacity: 0.08;
}

.orb-3 {
    width: 400px; height: 400px;
    background: var(--blue);
    top: 40%; left: 50%;
    opacity: 0.06;
}

[data-theme="light"] .orb { opacity: 0.15; }
[data-theme="light"] .orb-1 { opacity: 0.2; }
[data-theme="light"] .orb-2 { opacity: 0.12; }
[data-theme="light"] .orb-3 { opacity: 0.1; }

a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
button { cursor: pointer; border: none; background: none; font-family: inherit; color: inherit; }

.header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    background: var(--glass);
    border-bottom: 1px solid var(--glass-border);
}

.header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 20px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 1.2rem;
    flex-shrink: 0;
    transition: opacity var(--transition);
}

.logo:hover { opacity: 0.8; }

.logo-icon { font-size: 1.4rem; }

.search-box {
    flex: 1;
    max-width: 500px;
    position: relative;
    display: flex;
    align-items: center;
}

.search-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    pointer-events: none;
    z-index: 2;
}

#search-input {
    width: 100%;
    padding: 10px 16px 10px 42px;
    border-radius: 50px;
    border: 1px solid var(--glass-border);
    background: var(--glass);
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: all var(--transition);
}

#search-input::placeholder { color: var(--text-muted); }

#search-input:focus {
    border-color: var(--accent);
    background: var(--glass-hover);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

.search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    max-height: 400px;
    overflow-y: auto;
    display: none;
    z-index: 200;
}

.search-dropdown.active { display: block; }

.search-dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    transition: background var(--transition);
}

.search-dropdown-item:hover { background: var(--glass-hover); }

.search-dropdown-item img {
    width: 40px;
    height: 56px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
}

.search-dropdown-item .sd-title {
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.3;
}

.search-dropdown-item .sd-meta {
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.theme-toggle {
    flex-shrink: 0;
    padding: 4px;
}

.toggle-track {
    display: block;
    width: 48px;
    height: 26px;
    border-radius: 50px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    position: relative;
    transition: all var(--transition);
}

.toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}

[data-theme="light"] .toggle-thumb {
    transform: translateX(22px);
}

.app {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px;
    min-height: calc(100vh - 64px - 60px);
}

.hero {
    text-align: center;
    padding: 60px 20px 40px;
}

.hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 12px;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto 32px;
}

.hero-search {
    max-width: 550px;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
}

.hero-search .search-icon { left: 18px; width: 20px; height: 20px; }

.hero-search input {
    width: 100%;
    padding: 16px 20px 16px 50px;
    border-radius: 50px;
    border: 1px solid var(--glass-border);
    background: var(--glass);
    color: var(--text);
    font-size: 1rem;
    font-family: inherit;
    outline: none;
    transition: all var(--transition);
}

.hero-search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
    background: var(--glass-hover);
}

.hero-search .search-dropdown {
    top: calc(100% + 12px);
}

.section { margin-top: 48px; }

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.section-title {
    font-size: 1.4rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
}

.section-link {
    font-size: 0.85rem;
    color: var(--accent-light);
    font-weight: 500;
    transition: opacity var(--transition);
}

.section-link:hover { opacity: 0.8; }

.anime-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
}

.anime-card {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: all var(--transition);
    cursor: pointer;
}

.anime-card:hover {
    transform: translateY(-4px);
    background: var(--glass-hover);
    box-shadow: var(--shadow);
    border-color: var(--accent);
}

.anime-card-img {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
}

.anime-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.anime-card:hover .anime-card-img img {
    transform: scale(1.05);
}

.anime-card-rank {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
}

.anime-card-score {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
}

.anime-card-body {
    padding: 10px 12px;
}

.anime-card-title {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 4px;
}

.anime-card-meta {
    font-size: 0.7rem;
    color: var(--text-secondary);
}

.genre-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.genre-tag {
    padding: 8px 16px;
    border-radius: 50px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
}

.genre-tag:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    transform: translateY(-2px);
}

.article {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
    margin-top: 24px;
}

.article-sidebar {
    position: sticky;
    top: 88px;
    align-self: start;
}

.article-cover {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    margin-bottom: 20px;
}

.article-cover img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
}

.infobox {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.infobox-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--glass-border);
    font-size: 0.85rem;
}

.infobox-row:last-child { border-bottom: none; }

.infobox-label {
    color: var(--text-secondary);
    font-weight: 500;
}

.infobox-value {
    font-weight: 600;
    text-align: right;
}

.infobox-value.score { color: var(--gold); }
.infobox-value.rank { color: var(--accent-light); }

.article-main h1 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 4px;
}

.article-main .alt-titles {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 20px;
}

.article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
}

.meta-badge {
    padding: 5px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--glass);
    border: 1px solid var(--glass-border);
}

.meta-badge.type { background: var(--accent); color: #fff; border-color: var(--accent); }
.meta-badge.status { background: var(--green); color: #fff; border-color: var(--green); }
.meta-badge.rating { background: var(--gold); color: #000; border-color: var(--gold); }

.synopsis {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    padding: 24px;
    margin-bottom: 24px;
    line-height: 1.8;
    font-size: 0.95rem;
    color: var(--text);
}

.synopsis h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 12px;
}

.synopsis-text {
    max-height: 150px;
    overflow: hidden;
    position: relative;
    transition: max-height 0.4s ease;
    text-align: justify;
}

.synopsis-text::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px;
    background: linear-gradient(transparent, var(--bg-secondary));
    pointer-events: none;
}

.synopsis-text.expanded {
    max-height: 5000px;
}

.synopsis-text.expanded::after {
    display: none;
}

.synopsis-toggle {
    margin-top: 12px;
    padding: 6px 16px;
    border-radius: 50px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--accent-light);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
}

.synopsis-toggle:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
}

.genre-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
}

.genre-list .genre-tag { font-size: 0.75rem; padding: 5px 12px; }

.related-section { margin-top: 40px; }

.related-section h2 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 16px;
}

.browse-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
    padding: 20px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
}

.filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
}

.filter-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
}

.filter-group select {
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid var(--glass-border);
    background: var(--bg-secondary);
    color: var(--text);
    font-family: inherit;
    font-size: 0.8rem;
    outline: none;
    cursor: pointer;
}

.results-count {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
}

.list-view {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.list-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition);
}

.list-item:hover {
    background: var(--glass-hover);
    border-color: var(--accent);
    transform: translateX(4px);
}

.list-item img {
    width: 50px;
    height: 70px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
}

.list-item-rank {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--accent-light);
    min-width: 36px;
    text-align: center;
}

.list-item-info { flex: 1; min-width: 0; }

.list-item-title {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.list-item-meta {
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.list-item-score {
    font-weight: 700;
    color: var(--gold);
    font-size: 0.9rem;
    flex-shrink: 0;
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
}

.page-btn {
    padding: 8px 14px;
    border-radius: 8px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all var(--transition);
}

.page-btn:hover { background: var(--glass-hover); }
.page-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.loading {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 80px;
}

.spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--glass-border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary);
}

.empty-state .empty-icon { font-size: 3rem; margin-bottom: 12px; }

.footer {
    text-align: center;
    padding: 20px;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid var(--glass-border);
}

.footer a { color: var(--accent-light); }

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--glass-border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

.landing {
    text-align: center;
    padding: 60px 20px 40px;
}

.landing-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
}

.landing-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 48px;
}

.landing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
}

.landing-card {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 32px 24px;
    cursor: pointer;
    transition: all var(--transition);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.landing-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
}

.landing-anime:hover { border-color: #7c3aed; box-shadow: 0 8px 32px rgba(124, 58, 237, 0.2); }
.landing-manga:hover { border-color: #3b82f6; box-shadow: 0 8px 32px rgba(59, 130, 246, 0.2); }
.landing-manhwa:hover { border-color: #10b981; box-shadow: 0 8px 32px rgba(16, 185, 129, 0.2); }
.landing-doujin:hover { border-color: #f59e0b; box-shadow: 0 8px 32px rgba(245, 158, 11, 0.2); }
.landing-hentai:hover { border-color: #ef4444; box-shadow: 0 8px 32px rgba(239, 68, 68, 0.2); }

.landing-card-icon { font-size: 2.5rem; margin-bottom: 8px; }

.landing-card-title { font-size: 1.3rem; font-weight: 700; }

.landing-card-desc { font-size: 0.85rem; color: var(--text-secondary); }

.landing-card-count { font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; }

.hentai-toggle {
    margin-top: 12px;
    cursor: pointer;
}

.hentai-toggle input { display: none; }

.hentai-toggle-track {
    display: block;
    width: 44px;
    height: 24px;
    border-radius: 50px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    position: relative;
    transition: all var(--transition);
}

.hentai-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--text-muted);
    transition: all var(--transition);
}

.hentai-toggle input:checked + .hentai-toggle-track {
    background: var(--red);
    border-color: var(--red);
}

.hentai-toggle input:checked + .hentai-toggle-track .hentai-toggle-thumb {
    transform: translateX(20px);
    background: #fff;
}

.gate-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
}

.gate-modal.active { display: flex; }

.gate-content {
    background: var(--bg-secondary);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 40px;
    max-width: 400px;
    width: 90%;
    text-align: center;
}

.gate-icon { font-size: 3rem; margin-bottom: 16px; }

.gate-content h2 { font-size: 1.5rem; margin-bottom: 12px; }

.gate-content p { color: var(--text-secondary); margin-bottom: 20px; }

.gate-remember {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
}

.gate-actions { display: flex; gap: 12px; justify-content: center; }

.gate-btn {
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
    border: 1px solid var(--glass-border);
}

.gate-btn-cancel { background: var(--glass); color: var(--text); }
.gate-btn-cancel:hover { background: var(--glass-hover); }

.gate-btn-confirm { background: var(--red); color: #fff; border-color: var(--red); }
.gate-btn-confirm:hover { opacity: 0.9; }

.ep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
}

.ep-card {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: all var(--transition);
}

.ep-card:hover { transform: translateY(-3px); border-color: var(--accent); }

.ep-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }

.ep-title { font-size: 0.75rem; font-weight: 600; padding: 8px 10px 0; line-height: 1.3; }

.ep-site { font-size: 0.7rem; color: var(--text-secondary); padding: 2px 10px 8px; }

.read-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }

.read-links .genre-tag { cursor: pointer; }

.preview-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 0 12px;
}

.preview-strip img {
    height: 120px;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid var(--glass-border);
    transition: transform var(--transition);
    flex-shrink: 0;
}

.preview-strip img:hover { transform: scale(1.05); }

#reader-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(0, 0, 0, 0.95);
    display: none;
    align-items: center;
    justify-content: center;
}

#reader-overlay.active { display: flex; }

#reader-img {
    max-width: 95vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 4px;
}

.reader-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    color: #fff;
    font-weight: 600;
    background: linear-gradient(rgba(0,0,0,0.6), transparent);
}

.reader-close {
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    font-size: 1rem;
    cursor: pointer;
}

.reader-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.12);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
    cursor: pointer;
    transition: background var(--transition);
}

.reader-nav:hover { background: rgba(255,255,255,0.25); }

.reader-prev { left: 16px; }
.reader-next { right: 16px; }

.ch-list { display: flex; flex-direction: column; gap: 6px; }

.ch-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    transition: all var(--transition);
}

.ch-row:hover { background: var(--glass-hover); border-color: var(--accent); }

.ch-num { font-weight: 700; color: var(--accent-light); min-width: 64px; }

.ch-vol { color: var(--text-secondary); font-size: 0.75rem; }

.ch-group { flex: 1; color: var(--text-secondary); font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.ch-date { color: var(--text-muted); font-size: 0.75rem; white-space: nowrap; }

@media (max-width: 768px) {
    .header-inner { padding: 0 16px; gap: 12px; }
    .logo-text { display: none; }
    .app { padding: 20px 16px; }
    .hero { padding: 40px 16px 24px; }
    .anime-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
    .article { grid-template-columns: 1fr; gap: 24px; }
    .article-sidebar { position: static; }
    .article-cover { max-width: 250px; margin: 0 auto 20px; }
    .browse-filters { flex-direction: column; }
    .filter-group { width: 100%; }
    .filter-group select { flex: 1; }
    .landing { padding: 40px 16px 24px; }
    .landing-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .landing-card { padding: 20px 16px; }
}
