<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WeebWiki — Anime, Manga & More</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎌</text></svg>">
</head>
<body>
    <div class="bg-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <header class="header">
        <div class="header-inner">
            <a href="#/" class="logo" data-link>
                <span class="logo-icon">🎌</span>
                <span class="logo-text">WeebWiki</span>
            </a>
            <div class="search-box" id="header-search">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="text" id="search-input" placeholder="Search anime, manga, manhwa..." autocomplete="off">
                <div id="search-dropdown" class="search-dropdown"></div>
            </div>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                <span class="toggle-track"><span class="toggle-thumb"></span></span>
            </button>
        </div>
    </header>

    <main id="app" class="app"></main>

    <div id="gate-modal" class="gate-modal">
        <div class="gate-content glass">
            <div class="gate-icon">🔞</div>
            <h2>Adult Content</h2>
            <p>This section contains adult content (18+). You must be of legal age to view this content.</p>
            <label class="gate-remember">
                <input type="checkbox" id="gate-remember"> Don't show again
            </label>
            <div class="gate-actions">
                <button class="gate-btn gate-btn-cancel" onclick="closeGate()">Cancel</button>
                <button class="gate-btn gate-btn-confirm" onclick="confirmGate()">I am 18+</button>
            </div>
        </div>
    </div>

    <footer class="footer">
        <p>WeebWiki — Data from MyAnimeList, MangaDex & nhentai</p>
    </footer>

    <script src="data.js"></script>
    <script src="manga_chapters.js"></script>
    <script src="api.js"></script>
    <script src="app.js"></script>
</body>
</html>
