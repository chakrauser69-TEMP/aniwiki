#!/usr/bin/env python3
"""
WeebWiki Auto-Update Script
Fetches latest anime, manga, and manhwa data from Jikan API and MangaDex API,
then regenerates data.js for the website.

Usage:
    python3 update_data.py              # Update anime only (default)
    python3 update_data.py --manga      # Also fetch manga from MangaDex
    python3 update_data.py --full       # Full update (all pages, ~6000 anime + manga)

Schedule with Termux:
    termux-job-scheduler or cron to run weekly
"""

import json
import time
import urllib.request
import urllib.error
import os
import sys
from datetime import datetime

JIKAN_BASE = "https://api.jikan.moe/v4"
MANGADEX_BASE = "https://api.mangadex.org"
ANILIST_BASE = "https://graphql.anilist.co"
MU_BASE = "https://api.mangaupdates.com/v1"
OUTPUT_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data.js")
CHAPTERS_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "manga_chapters.js")
REQUEST_DELAY = 1.5
MU_DELAY = 1.0
MAX_RETRIES = 3


def fetch_json(url, retries=MAX_RETRIES):
    for attempt in range(retries):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "AnimeWiki-Updater/1.0"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            if e.code == 429:
                wait = int(e.headers.get("Retry-After", 5))
                print(f"  Rate limited, waiting {wait}s...")
                time.sleep(wait)
            else:
                print(f"  HTTP {e.code}, retrying...")
                time.sleep(REQUEST_DELAY * (attempt + 1))
        except Exception as e:
            print(f"  Error: {e}, retrying...")
            time.sleep(REQUEST_DELAY * (attempt + 1))
    return None


def fetch_top_anime(pages=5):
    all_anime = []
    for page in range(1, pages + 1):
        print(f"Fetching top anime page {page}/{pages}...")
        data = fetch_json(f"{JIKAN_BASE}/top/anime?page={page}&limit=25")
        if not data or "data" not in data:
            print(f"  No data returned for page {page}")
            break
        all_anime.extend(data["data"])
        print(f"  Got {len(data['data'])} entries (total: {len(all_anime)})")
        if page < pages:
            time.sleep(REQUEST_DELAY)
    return all_anime


def fetch_seasonal_anime(year=None, season=None):
    now = datetime.now()
    if year is None:
        year = now.year
    if season is None:
        month = now.month
        if month <= 3:
            season = "winter"
        elif month <= 6:
            season = "spring"
        elif month <= 9:
            season = "summer"
        else:
            season = "fall"
    print(f"Fetching seasonal anime: {season} {year}...")
    data = fetch_json(f"{JIKAN_BASE}/seasons/{year}/{season}")
    if data and "data" in data:
        print(f"  Got {len(data['data'])} seasonal entries")
        return data["data"]
    return []


def fetch_anime_details(mal_id):
    data = fetch_json(f"{JIKAN_BASE}/anime/{mal_id}/full")
    if data and "data" in data:
        return data["data"]
    return None


def parse_anime(entry):
    genres = [g["name"] for g in entry.get("genres", [])]
    themes = [g["name"] for g in entry.get("themes", [])]
    demographics = [g["name"] for g in entry.get("demographics", [])]
    studios = [s["name"] for s in entry.get("studios", [])]
    producers = [p["name"] for p in entry.get("producers", [])]

    images = entry.get("images", {})
    jpg = images.get("jpg", {})
    img_url = jpg.get("large_image_url") or jpg.get("image_url") or None

    trailer = entry.get("trailer", {})
    trailer_id = trailer.get("youtube_id") or None

    aired = entry.get("aired", {})
    aired_from = aired.get("from", None) if isinstance(aired, dict) else None
    aired_to = aired.get("to", None) if isinstance(aired, dict) else None

    year = entry.get("year")
    if not year and aired_from:
        try:
            year = int(aired_from[:4])
        except (ValueError, TypeError):
            pass

    season = entry.get("season")
    if not season and aired_from:
        try:
            month = int(aired_from[5:7])
            if month <= 3:
                season = "winter"
            elif month <= 6:
                season = "spring"
            elif month <= 9:
                season = "summer"
            else:
                season = "fall"
        except (ValueError, TypeError):
            pass

    synopsis = entry.get("synopsis", "")

    return {
        "id": entry.get("mal_id"),
        "title": entry.get("title", ""),
        "title_en": entry.get("title_english") or None,
        "title_jp": entry.get("title_japanese") or None,
        "img": img_url,
        "type": entry.get("type"),
        "episodes": entry.get("episodes"),
        "score": entry.get("score"),
        "rank": entry.get("rank"),
        "popularity": entry.get("popularity"),
        "members": entry.get("members"),
        "favorites": entry.get("favorites"),
        "synopsis": synopsis or None,
        "status": entry.get("status"),
        "rating": entry.get("rating"),
        "season": season,
        "year": year,
        "genres": genres or [],
        "themes": themes or [],
        "demographics": demographics or [],
        "studios": studios or [],
        "producers": producers or [],
        "aired_from": aired_from,
        "aired_to": aired_to,
        "trailer_youtube": trailer_id,
    }


def merge_data(existing, new_entries):
    existing_map = {a["id"]: a for a in existing}
    for entry in new_entries:
        if entry["id"] in existing_map:
            old = existing_map[entry["id"]]
            for key, val in entry.items():
                if val is not None and val != "" and val != []:
                    old[key] = val
        else:
            existing_map[entry["id"]] = entry
    return sorted(existing_map.values(), key=lambda a: -(a.get("members") or 0))


def fetch_manga_list(pages=3):
    all_manga = []
    for page in range(pages):
        offset = page * 100
        print(f"Fetching manga page {page + 1}/{pages}...")
        url = f"{MANGADEX_BASE}/manga?limit=100&offset={offset}&contentRating=safe&includes[]=cover_art&order[followedCount]=desc"
        data = fetch_json(url)
        if not data or "data" not in data:
            print(f"  No data returned for page {page + 1}")
            break
        all_manga.extend(data["data"])
        print(f"  Got {len(data['data'])} entries (total: {len(all_manga)})")
        if page < pages - 1:
            time.sleep(REQUEST_DELAY)
    return all_manga


def parse_manga(entry):
    attrs = entry.get("attributes", {})
    rels = entry.get("relationships", [])
    title = attrs.get("title", {}).get("en") or attrs.get("title", {}).get("ja-ro") or "Unknown"
    alt_titles = [t.get("en") or t.get("ja") for t in attrs.get("altTitles", []) if t.get("en") or t.get("ja")]
    desc = attrs.get("description", {}).get("en", "")
    tags = [t.get("attributes", {}).get("name", {}).get("en") for t in attrs.get("tags", []) if t.get("attributes", {}).get("name", {}).get("en")]
    cover_rel = next((r for r in rels if r.get("type") == "cover_art"), None)
    author_rel = next((r for r in rels if r.get("type") == "author"), None)
    artist_rel = next((r for r in rels if r.get("type") == "artist"), None)

    cover_file = cover_rel.get("attributes", {}).get("fileName") if cover_rel else None
    cover_url = f"https://uploads.mangadex.org/covers/{entry['id']}/{cover_file}.256.jpg" if cover_file else None

    return {
        "id": entry["id"],
        "title": title,
        "title_en": alt_titles[0] if alt_titles else None,
        "title_jp": attrs.get("title", {}).get("ja"),
        "img": cover_url,
        "type": attrs.get("format", "Manga"),
        "chapters": attrs.get("lastChapter"),
        "score": None,
        "rank": None,
        "popularity": None,
        "members": None,
        "favorites": None,
        "synopsis": desc or None,
        "status": attrs.get("status"),
        "year": attrs.get("year"),
        "genres": [t for t in tags if t in ["Action", "Adventure", "Comedy", "Drama", "Fantasy", "Horror", "Mystery", "Romance", "Sci-Fi", "Slice of Life", "Sports", "Supernatural", "Thriller"]],
        "themes": [t for t in tags if t not in ["Action", "Adventure", "Comedy", "Drama", "Fantasy", "Horror", "Mystery", "Romance", "Sci-Fi", "Slice of Life", "Sports", "Supernatural", "Thriller"]],
        "demographics": [],
        "authors": [author_rel["attributes"]["name"]] if author_rel and author_rel.get("attributes") else [],
        "artists": [artist_rel["attributes"]["name"]] if artist_rel and artist_rel.get("attributes") else [],
        "source": "mangadex"
    }


def main():
    pages = 5
    full = False
    fetch_manga = "--manga" in sys.argv
    if "--full" in sys.argv:
        full = True
        pages = 24
        fetch_manga = True
    elif "--pages" in sys.argv:
        idx = sys.argv.index("--pages")
        if idx + 1 < len(sys.argv):
            pages = int(sys.argv[idx + 1])

    print("=" * 50)
    print("WeebWiki Data Updater")
    print("=" * 50)

    existing = []
    if os.path.exists(OUTPUT_FILE):
        with open(OUTPUT_FILE, "r", encoding="utf-8") as f:
            content = f.read()
            try:
                start = content.index("[")
                end = content.rindex("]") + 1
                existing = json.loads(content[start:end])
                print(f"Loaded {len(existing)} existing entries")
            except (ValueError, json.JSONDecodeError):
                print("Could not parse existing data, starting fresh")

    new_entries = fetch_top_anime(pages)
    seasonal = fetch_seasonal_anime()
    new_entries.extend(seasonal)

    seen_ids = set()
    unique_entries = []
    for e in new_entries:
        if e["mal_id"] not in seen_ids:
            seen_ids.add(e["mal_id"])
            unique_entries.append(e)

    print(f"\nParsing {len(unique_entries)} unique anime entries...")
    parsed = [parse_anime(e) for e in unique_entries]
    parsed = [p for p in parsed if p["title"] and p.get("synopsis")]

    print("Merging with existing data...")
    merged = merge_data(existing, parsed)

    if fetch_manga:
        print("\nFetching manga from MangaDex...")
        manga_entries = fetch_manga_list(3)
        print(f"Parsing {len(manga_entries)} manga entries...")
        manga_parsed = [parse_manga(e) for e in manga_entries]
        manga_parsed = [m for m in manga_parsed if m["title"] and m.get("synopsis")]
        merged = merge_data(merged, manga_parsed)

    print(f"\nWriting {len(merged)} entries to {OUTPUT_FILE}...")
    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        f.write("const ANIME_DATA = ")
        json.dump(merged, f, ensure_ascii=False, separators=(",", ":"))
        f.write(";\n")

    size_mb = os.path.getsize(OUTPUT_FILE) / 1024 / 1024
    print(f"Done! {len(merged)} entries, {size_mb:.1f} MB")
    print(f"Updated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")


def anilist_post(query, variables):
    payload = json.dumps({"query": query, "variables": variables}).encode("utf-8")
    for attempt in range(MAX_RETRIES):
        try:
            req = urllib.request.Request(
                ANILIST_BASE, data=payload,
                headers={"Content-Type": "application/json", "Accept": "application/json", "User-Agent": "WeebWiki-Updater/1.0"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                if data.get("errors"):
                    print(f"  AniList error: {data['errors'][0].get('message')}")
                    return None
                return data.get("data")
        except Exception as e:
            print(f"  AniList error: {e}, retrying...")
            time.sleep(REQUEST_DELAY * (attempt + 1))
    return None


def mu_post(path, payload):
    body = json.dumps(payload).encode("utf-8")
    for attempt in range(MAX_RETRIES):
        try:
            req = urllib.request.Request(
                MU_BASE + path, data=body,
                headers={"Content-Type": "application/json", "Accept": "application/json", "User-Agent": "WeebWiki-Updater/1.0"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            if e.code == 429:
                print("  MU rate limited, waiting 10s...")
                time.sleep(10)
            else:
                print(f"  MU HTTP {e.code}, retrying...")
                time.sleep(MU_DELAY * (attempt + 1))
        except Exception as e:
            print(f"  MU error: {e}, retrying...")
            time.sleep(MU_DELAY * (attempt + 1))
    return None


def norm_title(t):
    return "".join(c.lower() for c in (t or "") if c.isalnum())


def fetch_chapters(top_n=40):
    print("=" * 50)
    print("WeebWiki Chapter Updater (AniList + MangaUpdates)")
    print("=" * 50)

    print(f"Fetching top {top_n} manga/manhwa from AniList...")
    data = anilist_post(
        "query($p:Int,$pp:Int){Page(page:$p,perPage:$pp){media(type:MANGA,isAdult:false,sort:POPULARITY_DESC){id title{romaji english}}}}",
        {"p": 1, "pp": top_n})
    if not data:
        print("Failed to fetch AniList top list")
        return
    entries = data["Page"]["media"]
    print(f"Got {len(entries)} titles")

    out = {}
    try:
        with open(CHAPTERS_FILE, "r", encoding="utf-8") as f:
            content = f.read()
            out = json.loads(content[content.index("{"):content.rindex("}") + 1])
            print(f"Resuming with {len(out)} existing series")
    except (OSError, ValueError):
        pass

    for i, m in enumerate(entries):
        aid = m["id"]
        if str(aid) in out:
            print(f"[{i + 1}/{len(entries)}] {m['title'].get('english') or m['title'].get('romaji')} (cached, skip)")
            continue
        titles = [t for t in [m["title"].get("english"), m["title"].get("romaji")] if t]
        title = titles[0] if titles else ""
        print(f"[{i + 1}/{len(entries)}] {title}...")
        if not title:
            continue

        rec = None
        series_url = None
        nt = None
        for cand in titles:
            search = mu_post("/series/search", {"search": cand, "page": 1, "perpage": 5})
            time.sleep(MU_DELAY)
            if not search or not search.get("results"):
                continue
            for r in search["results"]:
                if norm_title(r["record"].get("title", "")) == norm_title(cand):
                    rec = r["record"]
                    series_url = rec.get("url")
                    nt = norm_title(cand)
                    title = cand
                    break
            if rec:
                break
        if not rec:
            print("  no exact match")
            continue

        chapters = []
        for page in range(1, 4):
            rel = mu_post("/releases/search", {"search": title, "page": page, "perpage": 100})
            time.sleep(MU_DELAY)
            if not rel or not rel.get("results"):
                break
            for r in rel["results"]:
                rr = r["record"]
                if norm_title(rr.get("title", "")) != nt:
                    continue
                groups = ", ".join(g.get("name", "") for g in (rr.get("groups") or []))
                chapters.append({
                    "v": rr.get("volume"),
                    "c": rr.get("chapter"),
                    "g": groups or None,
                    "d": rr.get("release_date"),
                })
            if len(chapters) >= 150:
                break
        if not chapters:
            print("  no chapters found")
            continue

        def ch_key(x):
            try:
                return float(str(x.get("c", "0")).rstrip("abcdefghijklmnopqrstuvwxyz-~+? "))
            except (ValueError, TypeError):
                return -1
        chapters.sort(key=ch_key, reverse=True)
        out[str(aid)] = {"t": title, "u": series_url,
                         "updated": datetime.now().strftime("%Y-%m-%d"),
                         "ch": chapters[:150]}
        print(f"  saved {len(out[str(aid)]['ch'])} chapters")

    print(f"\nWriting {len(out)} series to {CHAPTERS_FILE}...")
    with open(CHAPTERS_FILE, "w", encoding="utf-8") as f:
        f.write("const MANGA_CHAPTERS = ")
        json.dump(out, f, ensure_ascii=False, separators=(",", ":"))
        f.write(";\n")
    import os as _os
    print(f"Done! {len(out)} series, {_os.path.getsize(CHAPTERS_FILE) / 1024:.0f} KB")


if __name__ == "__main__":
    if "--chapters" in sys.argv:
        n = 40
        if "--n" in sys.argv:
            idx = sys.argv.index("--n")
            if idx + 1 < len(sys.argv):
                n = int(sys.argv[idx + 1])
        fetch_chapters(n)
    else:
        main()
